NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Do not expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-system-tasks-only

# Twilio voice/SMS. Required when testing local call and text flows.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
TWILIO_FROM_PHONE=+15555555555

# Local webhook/testing config.
# Use your public tunnel URL, for example https://abc123.ngrok-free.app.
TWILIO_WEBHOOK_BASE_URL=https://your-public-tunnel-url

# Pick any long random value and send it as Bearer auth to the due-confirmations endpoint.
OFICIO_CRON_SECRET=replace-with-a-long-random-secret

# Optional. Only set this when a realtime voice gateway is running.
OFICIO_VOICE_STREAM_URL=wss://your-voice-gateway.example.com
