NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Do not expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-system-tasks-only

# OpenAI. Required for realtime voice. Also used for lazy owner-summary translations.
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSLATION_MODEL=gpt-5-nano

# Geocodio. Server-only geocoding for owner service areas and customer/job addresses.
GEOCODIO_API_KEY=your-geocodio-api-key

# Geoapify. Server-only address autocomplete suggestions for owner forms.
GEOAPIFY_API_KEY=your-geoapify-api-key

# Twilio voice/SMS. Required when testing local call and text flows.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
TWILIO_FROM_PHONE=+15555555555

# Optional email summaries.
RESEND_API_KEY=your-resend-api-key
OFICIO_SUMMARY_FROM_EMAIL=Ana <ana@yourdomain.com>

# Local webhook/testing config.
# Use your public tunnel URL, for example https://abc123.ngrok-free.app.
TWILIO_WEBHOOK_BASE_URL=https://your-public-tunnel-url

# Pick any long random value and send it as Bearer auth to the due-confirmations endpoint.
OFICIO_CRON_SECRET=replace-with-a-long-random-secret

# Vercel Cron sends this as a Bearer token automatically when configured.
CRON_SECRET=replace-with-a-long-random-secret

# Optional. Only set this when a realtime voice gateway is running.
OFICIO_VOICE_STREAM_URL=wss://your-voice-gateway.example.com

# Optional realtime voice gateway/local scheduling defaults.
OFICIO_NEXT_APP_ORIGIN=http://localhost:3000
OFICIO_VOICE_GATEWAY_PORT=8787
OFICIO_BOOKING_SLOT_MINUTES=120
OFICIO_BOOKING_SLOT_STEP_MINUTES=60
OFICIO_BOOKING_DAY_START_HOUR=8
OFICIO_BOOKING_DAY_END_HOUR=17
